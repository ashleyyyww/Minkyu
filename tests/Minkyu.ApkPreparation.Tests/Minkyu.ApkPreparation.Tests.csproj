<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
    <Compile Include="../../src/LoaderFixes.Android/BundledAssets.cs" Link="BundledAssets.cs" />
    <Compile Include="../../src/Minkyu.Android/ApkPreparation.cs" Link="ApkPreparation.cs" />
    <Compile Include="../../references/LemonLoaderInstaller/Core/Utilities/Axml/*.cs" Link="ThirdParty/Axml/%(Filename)%(Extension)" />
    <Compile Include="../../references/LemonLoaderInstaller/Core/Utilities/Signing/*.cs" Link="ThirdParty/Signing/%(Filename)%(Extension)" />
    <Compile Include="../../references/LemonLoaderInstaller/Core/IPatchLogger.cs" Link="ThirdParty/IPatchLogger.cs" />
  </ItemGroup>
</Project>
